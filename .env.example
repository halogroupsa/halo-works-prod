# Canonical production origin used by metadata, robots and all sitemap URLs.
NEXT_PUBLIC_SITE_URL=https://haloworks.ae
# Enquiries use the profile's WhatsApp and email contacts; no API key is required.
# Google Tag Manager container (GTM-XXXXXXX). Leave empty to ship no tag.
# The tag only loads when the page is visited on the NEXT_PUBLIC_SITE_URL host
# (with or without www). Every other host gets no tag and is marked noindex.
NEXT_PUBLIC_GTM_ID=

# Build the design-review export with draft projects using:
# HALO_PROJECT_PREVIEWS=1 npm run build
# Production builds use the default setting and publish out/.
